---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Badar Maulana" description="Page not found.">
  <section class="nf">
    <div class="container">
      <p class="mono prompt"><span class="dollar">$</span> cat {"{page}"}</p>
      <h1 class="mono">404: no such file or directory</h1>
      <p class="muted">The page you're looking for doesn't exist (anymore).</p>
      <a href="/" class="btn">cd ~/home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: 7rem 0;
    min-height: 55vh;
  }

  .prompt {
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .dollar {
    color: var(--accent);
  }

  .nf h1 {
    font-size: clamp(1.4rem, 4vw, 2rem);
    margin-bottom: 0.5rem;
  }

  .nf .btn {
    margin-top: 1.5rem;
  }
</style>
