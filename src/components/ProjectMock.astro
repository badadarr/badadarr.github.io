---
// CSS-only device mockup used as a project thumbnail when there is no
// real screenshot yet. Purely schematic — swap in a photo by giving the
// project an `image` instead.
export interface Mock {
  device: "phone" | "watch" | "browser";
  /** Accent colour for this app's UI */
  accent: string;
  title: string;
  /** Browser: the URL bar text. Phone/watch: small subtitle. */
  subtitle?: string;
  highlight?: { label: string; value: string };
  rows?: { label: string; meta?: string }[];
  chips?: string[];
  action?: string;
}

interface Props {
  mock: Mock;
}

const { mock } = Astro.props;
const { device, accent, title, subtitle, highlight, rows = [], chips = [], action } = mock;
---

<div class:list={["mock", `mock--${device}`]} style={`--mk: ${accent}`} aria-hidden="true">
  {
    device === "browser" ? (
      <div class="win">
        <div class="win-bar">
          <span class="dot" />
          <span class="dot" />
          <span class="dot" />
          <span class="url mono">{subtitle ?? "app.local"}</span>
        </div>
        <div class="win-body">
          <p class="mk-title">{title}</p>
          {(highlight || chips.length > 0) && (
            <div class="mk-meta mono">
              {highlight && (
                <div class="mk-stat">
                  <span class="v">{highlight.value}</span>
                  <span class="l">{highlight.label}</span>
                </div>
              )}
              {chips.length > 0 && (
                <div class="mk-chips">
                  {chips.map((c) => (
                    <span>{c}</span>
                  ))}
                </div>
              )}
            </div>
          )}
          <div class="mk-rows mono">
            {rows.map((r) => (
              <div class="mk-row">
                <span class="bar" />
                <span class="label">{r.label}</span>
                {r.meta && <span class="meta">{r.meta}</span>}
              </div>
            ))}
          </div>
        </div>
      </div>
    ) : device === "watch" ? (
      <div class="watch">
        <span class="crown" />
        <div class="watch-screen">
          <p class="mk-eyebrow mono">{title}</p>
          {highlight && (
            <p class="watch-value mono">
              {highlight.value}
              <span>{highlight.label}</span>
            </p>
          )}
          <div class="mk-rows mono">
            {rows.slice(0, 2).map((r) => (
              <div class="mk-row">
                <span class="bar" />
                <span class="label">{r.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class="phone">
        <div class="phone-screen">
          <div class="status mono">
            <span>9:41</span>
            <span class="notch" />
            <span class="batt">
              <span />
            </span>
          </div>
          <div class="appbar mono">
            <span class="app-dot" />
            {title}
          </div>
          {highlight && (
            <div class="mk-highlight mono">
              <span class="l">{highlight.label}</span>
              <span class="v">{highlight.value}</span>
            </div>
          )}
          <div class="mk-rows mono">
            {rows.map((r) => (
              <div class="mk-row">
                <span class="bar" />
                <span class="label">{r.label}</span>
                {r.meta && <span class="meta">{r.meta}</span>}
              </div>
            ))}
          </div>
          {chips.length > 0 && (
            <div class="mk-chips mono">
              {chips.map((c) => (
                <span>{c}</span>
              ))}
            </div>
          )}
          {action && <div class="mk-action mono">{action}</div>}
          <div class="tabbar">
            <span class="tab on" />
            <span class="tab" />
            <span class="tab" />
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .mock {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    background:
      radial-gradient(
        120% 80% at 50% 0%,
        color-mix(in srgb, var(--mk) 22%, transparent),
        transparent 70%
      ),
      var(--bg-raised);
  }

  /* shared bits ---------------------------------------------------- */
  .mk-rows {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .mk-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.52rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.26rem;
  }

  .mk-row .bar {
    width: 3px;
    height: 11px;
    border-radius: 2px;
    background: var(--mk);
    opacity: 0.75;
    flex-shrink: 0;
  }

  .mk-row .label {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mk-row .meta {
    margin-left: auto;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .mk-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.22rem;
  }

  .mk-chips span {
    font-size: 0.46rem;
    color: var(--mk);
    border: 1px solid color-mix(in srgb, var(--mk) 45%, transparent);
    background: color-mix(in srgb, var(--mk) 12%, transparent);
    border-radius: 999px;
    padding: 0.06rem 0.34rem;
  }

  /* phone ---------------------------------------------------------- */
  .mock--phone .phone {
    width: 168px;
    margin-top: 13px;
    border-radius: 26px;
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    padding: 6px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    transform: rotate(-3deg);
    align-self: flex-start;
  }

  .phone-screen {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 21px;
    padding: 0.42rem 0.55rem 0.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.36rem;
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.45rem;
    color: var(--text-faint);
  }

  .notch {
    width: 22px;
    height: 5px;
    border-radius: 999px;
    background: var(--border-strong);
  }

  .batt {
    width: 13px;
    height: 7px;
    border: 1px solid var(--text-faint);
    border-radius: 2px;
    padding: 1px;
    display: inline-flex;
  }

  .batt span {
    width: 70%;
    background: var(--mk);
    border-radius: 1px;
  }

  .appbar {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.58rem;
    font-weight: 700;
    color: var(--text);
  }

  .app-dot {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    background: var(--mk);
    flex-shrink: 0;
  }

  .mk-highlight {
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--mk) 40%, transparent);
    background: color-mix(in srgb, var(--mk) 10%, transparent);
    border-radius: 8px;
    padding: 0.35rem 0.45rem;
  }

  .mk-highlight .l {
    font-size: 0.45rem;
    color: var(--text-faint);
  }

  .mk-highlight .v {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mk);
  }

  .mk-action {
    text-align: center;
    font-size: 0.5rem;
    font-weight: 600;
    color: #0b0e14;
    background: var(--mk);
    border-radius: 6px;
    padding: 0.28rem;
  }

  .tabbar {
    display: flex;
    justify-content: space-around;
    border-top: 1px solid var(--border);
    padding-top: 0.32rem;
    margin-top: 0.1rem;
  }

  .tab {
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background: var(--border-strong);
  }

  .tab.on {
    background: var(--mk);
  }

  /* watch ---------------------------------------------------------- */
  .mock--watch {
    align-items: center;
  }

  .watch {
    position: relative;
    width: 130px;
    border-radius: 34px;
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    padding: 9px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    transform: rotate(-3deg);
  }

  .crown {
    position: absolute;
    right: -4px;
    top: 34%;
    width: 4px;
    height: 20px;
    border-radius: 2px;
    background: var(--border-strong);
  }

  .watch-screen {
    background: #05070b;
    border-radius: 26px;
    padding: 0.6rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-height: 118px;
  }

  .mk-eyebrow {
    font-size: 0.5rem;
    color: var(--mk);
    font-weight: 600;
  }

  .watch-value {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .watch-value {
    font-size: 1.15rem;
    font-weight: 700;
    color: #dbe2ea;
  }

  .watch-value span {
    font-size: 0.45rem;
    font-weight: 400;
    color: #8a94a3;
  }

  .mock--watch .mk-row {
    border-bottom-color: rgba(255, 255, 255, 0.08);
    color: #8a94a3;
  }

  /* browser -------------------------------------------------------- */
  .mock--browser {
    align-items: center;
  }

  .win {
    width: 86%;
    max-width: 300px;
    border-radius: 9px;
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-raised);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .url {
    flex: 1;
    margin-left: 0.3rem;
    font-size: 0.45rem;
    color: var(--text-faint);
    background: var(--bg);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .win-body {
    padding: 0.6rem 0.7rem 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--bg);
  }

  .mk-title {
    font-size: 0.62rem;
    font-weight: 700;
  }

  .mk-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .mk-stat {
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--mk) 40%, transparent);
    background: color-mix(in srgb, var(--mk) 10%, transparent);
    border-radius: 5px;
    padding: 0.25rem 0.45rem;
  }

  .mk-stat .v {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--mk);
  }

  .mk-stat .l {
    font-size: 0.4rem;
    color: var(--text-faint);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
</style>
