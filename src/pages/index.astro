---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import DevLog from "../components/DevLog.astro";
import HeroPhone from "../components/HeroPhone.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
import portrait from "../assets/images/badar.jpg";

const featured = projects.filter((p) => p.featured);

const highlights = [
  {
    icon: "terminal" as const,
    title: "Full Stack Development",
    text: "Building scalable web & mobile applications with Laravel, Flutter, and Next.js",
  },
  {
    icon: "zap" as const,
    title: "Cross-Platform Apps",
    text: "Shipping seamless experiences across iOS, Android & the web",
  },
  {
    icon: "bot" as const,
    title: "AI-Assisted Workflow",
    text: "Leveraging modern AI tooling to write efficient, maintainable code",
  },
];

const contacts = [
  {
    icon: "mail" as const,
    title: "email",
    value: site.email,
    href: `mailto:${site.email}`,
  },
  {
    icon: "whatsapp" as const,
    title: "whatsapp",
    value: site.whatsappLabel,
    href: site.whatsapp,
  },
  {
    icon: "linkedin" as const,
    title: "linkedin",
    value: "in/badadarr",
    href: site.linkedin,
  },
  {
    icon: "github" as const,
    title: "github",
    value: "@badadarr",
    href: site.github,
  },
];
---

<Base
  title="Badar Maulana — Mobile & Full Stack Developer"
  description="Badar Maulana — Mobile & Full Stack Developer specializing in Flutter, Swift, Laravel, Next.js, and Python. Based in Indonesia."
>
  <!-- ================= HERO ================= -->
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="mono prompt"><span class="dollar">$</span> whoami</p>
        <h1>Badar Maulana</h1>
        <p class="mono role">
          mobile & full-stack developer<span class="cursor">▍</span>
        </p>
        <p class="hero-desc">
          I build mobile apps with <strong>Flutter</strong> and
          <strong>Swift</strong>, backed by <strong>Laravel</strong> and
          <strong>Next.js</strong> — currently developing ERP systems at PT.
          Spero Mahakarya Nusantara and finishing a CS degree at President
          University.
        </p>
        <div class="hero-actions">
          <span class="status mono"><span class="pulse"></span>open to opportunities</span>
          <a href="/projects.html" class="btn btn--solid">
            view work <Icon name="arrow-right" />
          </a>
          <a href={site.cv} target="_blank" rel="noopener noreferrer" class="btn">
            <Icon name="download" /> download cv
          </a>
        </div>
      </div>
      <HeroPhone />
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section id="about">
    <div class="container">
      <SectionHead title="about" />
      <div class="about-grid">
        <div class="about-photo reveal">
          <Image
            src={portrait}
            alt="Badar Maulana"
            width={420}
            widths={[320, 420, 640]}
            sizes="(max-width: 800px) 60vw, 300px"
            format="webp"
            quality={80}
          />
        </div>
        <div class="about-text">
          <p class="reveal">
            A full-stack developer concentrating in <strong>IoT</strong> at
            President University. I care about clean code, honest UX, and
            shipping things that actually get used — from hospital apps to
            government portals to ERP systems.
          </p>
          <div class="about-stats mono reveal">
            <div class="stat">
              <span class="num">2+</span>
              <span class="label">years experience</span>
            </div>
            <div class="stat">
              <span class="num">10</span>
              <span class="label">projects shipped</span>
            </div>
            <div class="stat">
              <span class="num">12</span>
              <span class="label">companies worked with</span>
            </div>
          </div>
          <ul class="highlights">
            {
              highlights.map((h) => (
                <li class="reveal">
                  <span class="hl-icon">
                    <Icon name={h.icon} size={17} />
                  </span>
                  <div>
                    <h3>{h.title}</h3>
                    <p>{h.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="about-cta reveal">
            <a href="/experience.html" class="btn">
              <Icon name="briefcase" /> view experience
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FEATURED WORK ================= -->
  <section id="work">
    <div class="container">
      <SectionHead title="selected work" />
      <div class="work-grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
      <div class="work-cta reveal">
        <a href="/projects.html" class="btn">
          all projects <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <!-- ================= DEV JOURNAL ================= -->
  <DevLog />

  <!-- ================= CONTACT ================= -->
  <section id="contact">
    <div class="container">
      <SectionHead title="contact" />
      <p class="contact-intro muted reveal">
        Available for freelance work and full-time opportunities. The fastest
        way to reach me is email or WhatsApp.
      </p>
      <div class="contact-grid">
        {
          contacts.map((c) => (
            <a
              class="card contact-card reveal"
              href={c.href}
              target={c.href.startsWith("mailto") ? undefined : "_blank"}
              rel="noopener noreferrer"
            >
              <span class="contact-icon">
                <Icon name={c.icon} size={18} />
              </span>
              <span class="contact-meta">
                <span class="mono title">{c.title}</span>
                <span class="value">{c.value}</span>
              </span>
              <Icon name="arrow-up-right" size={16} class="contact-arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding: 6rem 0 5rem;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 26px 26px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 4.5rem 0 4rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  .prompt {
    color: var(--text-faint);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .dollar {
    color: var(--accent);
  }

  .hero h1 {
    font-family: var(--font-mono);
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .role {
    color: var(--accent-bright);
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    margin: 0.5rem 0 1.25rem;
  }

  .cursor {
    animation: blink 1.1s steps(2) infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .hero-desc {
    max-width: 38rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .hero-desc strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--accent-bright);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-dim);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-bright);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* ---------- about ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about-photo :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .about-text > p {
    font-size: 1.02rem;
    max-width: 40rem;
  }

  .about-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 0.75rem 1.1rem;
    min-width: 8.5rem;
  }

  .stat .num {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent-bright);
  }

  .stat .label {
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .highlights li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .hl-icon {
    display: inline-flex;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--accent-bright);
    background: var(--bg-soft);
    flex-shrink: 0;
  }

  .highlights h3 {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .highlights p {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .about-cta {
    margin-top: 1.5rem;
  }

  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      max-width: 260px;
    }
  }

  /* ---------- work ---------- */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .work-cta {
    margin-top: 1.75rem;
    text-align: center;
  }

  /* ---------- contact ---------- */
  .contact-intro {
    max-width: 40rem;
    margin: -1rem 0 1.75rem;
    font-size: 0.95rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    color: var(--text);
  }

  .contact-card:hover {
    text-decoration: none;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    transform: translateY(-2px);
  }

  .contact-icon {
    display: inline-flex;
    padding: 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--accent-bright);
    background: var(--bg-raised);
    flex-shrink: 0;
  }

  .contact-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact-meta .title {
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .contact-meta .value {
    font-size: 0.88rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.contact-arrow) {
    margin-left: auto;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .contact-card:hover :global(.contact-arrow) {
    color: var(--accent-bright);
  }
</style>
